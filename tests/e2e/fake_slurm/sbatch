#!/usr/bin/env python3
"""Minimal synchronous SLURM `sbatch` emulator for end-to-end tests.

It accepts the options the TRU-ROH launchers use, runs the batch script immediately
(once per array index), honours --output/--error/--chdir, exports the usual SLURM_*
variables, prints the job id (``--parsable`` style) and appends every call to
``$FAKE_SLURM_LOG``. Because jobs run in submission order, dependencies are satisfied
by construction; ``afterok`` dependencies on a failed job make the dependent job fail,
mirroring SLURM. It is a test harness, not a scheduler.
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

state_dir = Path(os.environ.get("FAKE_SLURM_STATE", "/tmp/fake_slurm_state"))
state_dir.mkdir(parents=True, exist_ok=True)
counter = state_dir / "next_id"
jobid = int(counter.read_text()) if counter.exists() else 1000
counter.write_text(str(jobid + 1))

argv = sys.argv[1:]
opts, script, script_args = {}, None, []
i = 0
flags_without_value = {"--parsable", "--wait", "--requeue", "--no-requeue", "--test-only", "--exclusive"}
while i < len(argv):
    a = argv[i]
    if script is None and a.startswith("-"):
        if a in flags_without_value:
            opts[a.lstrip("-")] = True
            i += 1
            continue
        if "=" in a:
            k, v = a.split("=", 1)
            opts[k.lstrip("-")] = v
            i += 1
            continue
        if a in {"-J", "-o", "-e", "-c", "-t", "-p", "-A", "-a", "-d", "-D", "-C", "-n", "-N"}:
            short = {"-J": "job-name", "-o": "output", "-e": "error", "-c": "cpus-per-task", "-t": "time", "-p": "partition",
                     "-A": "account", "-a": "array", "-d": "dependency", "-D": "chdir", "-C": "constraint", "-n": "ntasks", "-N": "nodes"}[a]
            opts[short] = argv[i + 1]
            i += 2
            continue
        opts[a.lstrip("-")] = argv[i + 1] if i + 1 < len(argv) else ""
        i += 2
        continue
    if script is None:
        script = a
    else:
        script_args.append(a)
    i += 1

if "wrap" in opts:
    script = None
for k in ("constraint", "partition", "account"):
    if k in opts and opts[k] == "":
        print(f"sbatch: error: --{k} requires a non-empty value", file=sys.stderr)
        sys.exit(1)

failed = state_dir / "failed_jobs.json"
failed_ids = set(json.loads(failed.read_text())) if failed.exists() else set()
dep = opts.get("dependency", "")
blocked = any(t == "afterok" and any(j.split("_")[0] in failed_ids for j in ids.split(":"))
              for t, ids in re.findall(r"(after\w*):([\d:_]+)", dep))

indices = [None]
if "array" in opts:
    spec = opts["array"].split("%")[0]
    indices = []
    for part in spec.split(","):
        if "-" in part:
            lo, hi = part.split("-")
            indices += list(range(int(lo), int(hi) + 1))
        else:
            indices.append(int(part))

record = {"job_id": jobid, "argv": argv, "options": opts, "script": script, "args": script_args, "blocked": blocked, "tasks": []}
status = 0
for idx in indices:
    if blocked:
        break
    env = dict(os.environ)
    env.update(SLURM_JOB_ID=str(jobid), SLURM_CPUS_PER_TASK=str(opts.get("cpus-per-task", 1)),
               SLURM_JOB_NAME=opts.get("job-name", "job"), SLURM_SUBMIT_DIR=os.getcwd())
    def sub(p):
        p = p.replace("%A", str(jobid)).replace("%j", str(jobid)).replace("%x", opts.get("job-name", "job"))
        return p.replace("%a", str(idx) if idx is not None else "0")
    if idx is not None:
        env.update(SLURM_ARRAY_JOB_ID=str(jobid), SLURM_ARRAY_TASK_ID=str(idx))
    for k, v in list(opts.items()):
        if k == "export" and isinstance(v, str) and v not in ("ALL", "NONE"):
            for kv in v.split(","):
                if "=" in kv and not kv.startswith("ALL"):
                    ek, ev = kv.split("=", 1)
                    env[ek] = ev
    out = sub(opts.get("output", f"slurm-{jobid}.out"))
    err = sub(opts.get("error", out))
    cwd = opts.get("chdir") or os.getcwd()
    Path(out).parent.mkdir(parents=True, exist_ok=True)
    Path(err).parent.mkdir(parents=True, exist_ok=True)
    cmd = ["bash", "-c", opts["wrap"]] if "wrap" in opts else ["bash", script] + script_args
    with open(out, "a") as fo, open(err, "a") as fe:
        rc = subprocess.run(cmd, env=env, cwd=cwd, stdout=fo, stderr=fe if err != out else fo).returncode
    record["tasks"].append({"index": idx, "rc": rc, "output": out})
    status = status or rc
if blocked or status:
    failed_ids.add(str(jobid))
    failed.write_text(json.dumps(sorted(failed_ids)))
with open(os.environ.get("FAKE_SLURM_LOG", str(state_dir / "sbatch_calls.jsonl")), "a") as log:
    log.write(json.dumps(record) + "\n")
print(f"{jobid}" if opts.get("parsable") else f"Submitted batch job {jobid}")
